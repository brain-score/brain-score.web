files:
  /usr/local/bin/brainscore-metadata-sync:
    mode: "000750"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail
      export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      enabled=$(/opt/elasticbeanstalk/bin/get-config environment -k MODEL_METADATA_SYNC_ENABLED)
      if [ "$enabled" != "1" ]; then
          exit 0
      fi
      containers=$(docker ps --filter publish=80 --format '{{.ID}}')
      if [ -z "$containers" ] || [ "$(printf '%s\n' "$containers" | wc -l)" -ne 1 ]; then
          echo "Metadata synchronization requires one running website container."
          exit 1
      fi
      docker exec --workdir /app "$containers" \
          /opt/conda/envs/brain-score.web/bin/python manage.py sync_model_metadata
  /etc/cron.d/brainscore-metadata-sync:
    mode: "000644"
    owner: root
    group: root
    content: |
      */5 * * * * root /usr/bin/flock -n /var/run/brainscore-metadata-sync.lock /usr/local/bin/brainscore-metadata-sync >> /var/log/brainscore-metadata-sync.log 2>&1
  /etc/logrotate.d/brainscore-metadata-sync:
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/brainscore-metadata-sync.log {
          weekly
          rotate 4
          missingok
          notifempty
          copytruncate
          compress
      }
commands:
  metadata_sync_log_permissions:
    command: |
      umask 077
      touch /var/log/brainscore-metadata-sync.log
      chmod 0640 /var/log/brainscore-metadata-sync.log
